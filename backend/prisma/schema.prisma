generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Email {
  id              String          @id @default(uuid())
  filename        String
  sha256Hash      String?         // Cryptographic SHA-256 fingerprint of evidence buffer
  from            String
  to              String
  cc              String?
  subject         String
  date            String?
  messageId       String?
  replyTo         String?
  returnPath      String?
  textBodySnippet String?
  htmlBodyExists  Boolean         @default(false)
  attachmentCount Int             @default(0)
  receivedHeaders Json?           // Stores the array of hop infrastructure
  spfResult       String?         @default("UNKNOWN")
  dkimResult      String?         @default("UNKNOWN")
  dmarcResult     String?         @default("UNKNOWN")
  createdAt       DateTime        @default(now())
  analysisReport  AnalysisReport?
  caseId          String?
  case            Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  auditLogs       AuditLog[]
}

model AnalysisReport {
  id              String   @id @default(uuid())
  emailId         String   @unique
  email           Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  threatLevel     String   @default("UNKNOWN")
  riskScore       Int      @default(0)
  severity        String   @default("LOW")
  summary         String?
  anomalies       Json?    // Array of anomaly strings
  riskFactors     Json?    // Array of factor objects with points
  domainAnalysis  Json?    // Domain & typosquatting results
  urlAnalysis     Json?    // Embedded URLs and risk flags
  routeAnalysis   Json?    // Hop chain, delays, originating IP, geo
  threatIntel     Json?    // IOC hits across AbuseIPDB, URLhaus, etc.
  attachments     Json?    // Attachment metadata and risk flags
  nlpAnalysis     Json?    // NLP social engineering & BEC heuristic results
  aiAnalysis      Json?    // True LLM (Groq) semantic analysis
  createdAt       DateTime @default(now())
}

model Case {
  id          String     @id @default(uuid())
  name        String
  description String?
  status      String     @default("OPEN") // OPEN, CLOSED, ESCALATED
  priority    String     @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  emails      Email[]
  auditLogs   AuditLog[]
}

model AuditLog {
  id          String   @id @default(uuid())
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  emailId     String?
  email       Email?   @relation(fields: [emailId], references: [id], onDelete: Cascade)
  action      String   // e.g., CASE_CREATED, EVIDENCE_ADDED
  performedBy String   @default("SYSTEM")
  timestamp   DateTime @default(now())
  details     Json?    // Stores old/new values or hashes
}

